{
  "manifest_version": 3,
  "name": "TrendNow - Rising Trends",
  "version": "2.0.0",
  "description": "Real-time Google Trends scanner. Spot rising topics, keywords & viral signals before they explode.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrendNow"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://trends.google.com/*", "*://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://suggestqueries.google.com/*",
    "*://trends.google.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' https://checkout.razorpay.com 'unsafe-inline'; style-src 'self' 'unsafe-inline';"
  }
}